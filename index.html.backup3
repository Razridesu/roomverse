room.add(box(3.92,.13,.18,ivoryPaint,0,.46,-3.75,false));
room.add(box(.09,1.83,.16,ivoryPaint,-1.91,1.42,-3.74,false));
room.add(box(.09,1.83,.16,ivoryPaint,1.91,1.42,-3.74,false));
// Low-profile ceiling light elements, no broad opaque slab that would obscure editing.
for(const x of [-1.45,1.45]) for(const z of [-2.7,2.25]){
