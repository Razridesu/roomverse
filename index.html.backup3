<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<meta name="theme-color" content="#f1eee8"/>
<title>ROOMVERSE v0.5.0 — LIFE & STUDIO</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;500;600&family=Noto+Serif+JP:wght@400;500&display=swap');
:root{--quartz:#f1eee8;--white:#fff;--ink:#383735;--line:#d8d5d0;--muted:#78736d;--panel:#ffffffed}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--quartz);color:var(--ink);font-family:'Noto Serif JP',serif}button,select,input{font:inherit}button{cursor:pointer}#scene{position:fixed;inset:0;touch-action:none}canvas{display:block}
.topbar{position:fixed;left:max(16px,env(safe-area-inset-left));right:max(16px,env(safe-area-inset-right));top:max(14px,env(safe-area-inset-top));display:flex;align-items:flex-start;justify-content:space-between;pointer-events:none;z-index:10;gap:8px}.brand,.actions,.chip,.status{pointer-events:auto;backdrop-filter:blur(16px);background:#fffffff2;border:1px solid #dfdbd5;border-radius:12px;box-shadow:0 4px 25px #2d24110b}.brand{padding:9px 14px;font:500 clamp(19px,3.5vw,26px)/1 'Bodoni Moda',serif;letter-spacing:.07em}.actions{display:flex;gap:5px;padding:5px}.icon-btn{border:0;background:transparent;color:var(--ink);min-width:38px;height:38px;border-radius:9px;font:18px Arial,sans-serif}.icon-btn:hover,.icon-btn.active{background:#eeebe5}.icon-btn:disabled{opacity:.35;cursor:default}
.bottom{position:fixed;bottom:max(17px,env(safe-area-inset-bottom));left:16px;right:16px;display:flex;align-items:flex-end;justify-content:space-between;gap:8px;z-index:10;pointer-events:none}.room-label{pointer-events:auto;background:#ffffffde;border:1px solid #dfdbd5;border-radius:11px;padding:10px 12px;font:13px 'Bodoni Moda',serif;letter-spacing:.03em;backdrop-filter:blur(12px)}.primary{pointer-events:auto;background:var(--ink);border:1px solid var(--ink);color:white;border-radius:26px;padding:12px 20px;font:14px 'Bodoni Moda',serif;letter-spacing:.11em;min-width:105px;box-shadow:0 8px 26px #25221d20}.primary:hover{background:#57544f}
.editor{position:fixed;z-index:9;bottom:calc(max(74px,env(safe-area-inset-bottom) + 67px));left:50%;transform:translateX(-50%);width:min(500px,calc(100% - 30px));background:#fffffff3;backdrop-filter:blur(20px);border:1px solid #ddd8d2;border-radius:18px;padding:14px;box-shadow:0 12px 40px #2c24151c;display:none;max-height:min(58vh,560px);overflow:auto}.editor.open{display:block}.section-title{font:500 15px 'Bodoni Moda',serif;letter-spacing:.1em;display:flex;justify-content:space-between;align-items:center;margin:0 0 12px}.caption{color:var(--muted);font-size:11px}.tabs{display:flex;gap:7px;margin-bottom:12px}.tab{background:transparent;border:1px solid var(--line);color:var(--ink);border-radius:10px;padding:10px 6px;flex:1;font-size:12px}.tab.selected{background:#e7e3dc;border-color:#b4aea4}.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.tool{background:#f8f7f4;border:1px solid #e1ddd7;color:var(--ink);border-radius:12px;padding:12px 6px;min-height:68px;display:flex;flex-direction:column;align-items:center;gap:5px;font-size:12px}.tool em{font-size:22px;font-style:normal}.tool:disabled{opacity:.4}.row{display:flex;gap:8px;align-items:center;justify-content:space-between}.sub-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}.small{border:1px solid var(--line);background:white;color:var(--ink);padding:9px 10px;border-radius:9px;font-size:12px}.small.danger{color:#9e5555}.small:disabled{opacity:.4}.field{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px 0;font-size:12px}input[type=range]{width:56%;accent-color:#6e726b}select{border-radius:8px;border:1px solid var(--line);background:white;color:var(--ink);padding:8px;max-width:56%}.hint{position:fixed;top:74px;left:50%;transform:translateX(-50%);z-index:8;background:#ffffffe0;padding:8px 12px;border-radius:30px;border:1px solid #e1ddd7;color:#57534e;font-size:11px;text-align:center;max-width:calc(100vw - 20px);pointer-events:none;transition:opacity .3s}.toast{position:fixed;z-index:30;top:85px;left:50%;transform:translateX(-50%);background:#383735;color:#fff;padding:11px 17px;border-radius:12px;font-size:12px;opacity:0;transition:opacity .25s;pointer-events:none}.toast.show{opacity:1}.status{position:fixed;right:16px;top:75px;z-index:7;padding:7px 10px;font-size:10px;color:var(--muted)}.hide{display:none!important}
@media(min-width:900px){.editor{left:20px;top:96px;bottom:auto;transform:none;width:296px;max-height:calc(100vh - 125px);padding:16px}.status{top:76px}.bottom{left:20px;right:20px}.tools{grid-template-columns:repeat(2,1fr)}.tool{min-height:80px}.hint{top:22px;left:50%}}
@media(max-height:540px){.editor{max-height:50vh}.hint{display:none}}

/* v0.2 — fullscreen first, compact editor, safe-area aware */
:root{--panel:#fffffff7}
.topbar{top:max(12px,env(safe-area-inset-top));align-items:center}
.brand{font-size:clamp(16px,3vw,23px);padding:10px 12px}
.actions{border-radius:13px}
.status{top:calc(max(12px,env(safe-area-inset-top)) + 59px);right:16px;max-width:145px;text-align:right}
.hint{top:calc(max(12px,env(safe-area-inset-top)) + 70px);opacity:.82;max-width:66vw;font-size:10px;line-height:1.6}
.bottom{bottom:max(12px,env(safe-area-inset-bottom));transition:bottom .22s;z-index:14}
.editor{left:12px;right:12px;width:auto;transform:none;bottom:calc(max(12px,env(safe-area-inset-bottom)) + 68px);max-height:min(34dvh,295px);overflow:auto;padding:11px 13px;border-radius:17px;box-shadow:0 9px 30px #2c24151c;transition:max-height .2s,opacity .2s;}
.editor.open{display:block}
.editor.collapsed{max-height:62px;overflow:hidden}
.editor.collapsed .tabs,.editor.collapsed #panel{display:none}
.section-title{margin:0 0 8px;min-height:28px;font-size:13px}
.editor.collapsed .section-title{margin-bottom:0}
.editor-title{display:flex;gap:7px;align-items:center}
.editor-top-right{display:flex;gap:6px;align-items:center}
.drawer-toggle{border:1px solid var(--line);background:#f7f6f3;border-radius:8px;min-width:33px;height:28px;color:var(--ink);font-size:17px}
.tabs{margin-bottom:8px;gap:5px}.tab{padding:8px 6px}
.tools{gap:6px}.tool{min-height:57px;padding:7px 4px;font-size:11px}.tool em{font-size:18px}
.sub-actions{margin-top:7px}.small{padding:8px;font-size:11px}
.caption{line-height:1.65}.panel-note{margin:6px 0 2px}
.setting-chip{border:1px solid var(--line);border-radius:8px;background:#f7f6f3;color:var(--ink);padding:8px 9px;font-size:11px;cursor:pointer}
.setting-chip.selected{background:#e4e6e1;border-color:#818f7e}
.setting-row{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0}
.tool.active,.small.active{background:#e4e6e1;border-color:#859581}
.edit-placeholder{background:#f8f7f4;border:1px solid #e1ddd7;border-radius:10px;padding:9px;font-size:11px;color:#706b65}
@media(max-width:600px){
 .brand{font-size:17px;letter-spacing:.04em}.topbar{gap:6px}.actions{padding:4px;gap:0}
 .icon-btn{min-width:33px;height:34px;font-size:17px}.status{font-size:9px}
 .editor{max-height:min(31dvh,260px)}.editor.expanded{max-height:min(47dvh,420px)}
 .editor.collapsed{max-height:53px}
 .hint{max-width:54vw;left:16px;transform:none;text-align:left;padding:7px 9px}
}
@media(min-width:900px){
 .editor{left:20px;right:auto;top:95px;bottom:auto;width:310px;max-height:calc(100dvh - 140px);padding:15px;transform:none}
 .editor.expanded{max-height:calc(100dvh - 140px)}.editor.collapsed{max-height:55px}
 .bottom{left:20px;right:20px}.tools{grid-template-columns:repeat(2,1fr)}
 .hint{top:22px;left:50%;transform:translateX(-50%)}
}

/* v0.3 : camera controls remain reachable above editor */
.camera-dock{position:fixed;z-index:22;right:12px;top:calc(max(12px,env(safe-area-inset-top)) + 64px);display:flex;flex-direction:column;gap:6px;pointer-events:auto}
.camera-dock button{border:1px solid #dad6cf;background:#fffffff2;border-radius:11px;min-width:61px;height:41px;color:#383735;box-shadow:0 4px 18px #28221c15;font:20px Arial,sans-serif}
.camera-dock button span{font:9px 'Bodoni Moda',serif;letter-spacing:.04em;display:block}
.hint{display:none}.topbar{z-index:24}.status{z-index:23;top:calc(max(12px,env(safe-area-inset-top)) + 247px)}
.editor{z-index:20;max-height:min(31dvh,252px)}.editor.collapsed{max-height:49px}.editor.expanded{max-height:min(46dvh,385px)}
.tabs{display:grid;grid-template-columns:repeat(4,1fr)}.tab{min-width:0;padding:7px 2px;font-size:11px}
@media(max-width:600px){.brand{font-size:15px;padding:8px}.icon-btn{min-width:32px}.camera-dock button{min-width:47px;height:42px}.editor{max-height:min(29dvh,240px)}.editor.expanded{max-height:min(42dvh,370px)}.status{top:auto;bottom:calc(max(12px,env(safe-area-inset-bottom)) + 72px);left:12px;right:auto}}
@media(min-width:900px){.camera-dock{top:95px;right:20px}.editor{max-height:calc(100dvh - 140px)}.editor.expanded{max-height:calc(100dvh - 140px)}}

/* v0.3.1 - clear release identity and accessible window controls */
.version-stamp{font:600 10px Arial,sans-serif;letter-spacing:0;color:#6b706b;vertical-align:middle;margin-left:5px}
.window-quick{background:#e5eee8!important;border-color:#9aada0!important}
.camera-dock{max-height:calc(100dvh - 245px);overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none}
.camera-dock button{flex-shrink:0}
.window-hint{margin:5px 0 0;color:#68645e;font-size:11px;line-height:1.6}
.window-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin:9px 0}
.window-option{background:#f7f6f3;border:1px solid #d8d5d0;border-radius:11px;min-height:51px;padding:9px;color:#383735;text-align:left;font:12px 'Noto Serif JP',serif}
.window-option.selected{background:#e5eee8;border-color:#8da69a}
.window-option small{display:block;font:10px Arial,sans-serif;color:#76736d;margin-top:4px;letter-spacing:.04em}
.window-corner{background:#f2f0ec;border:1px solid #d5d0c8;border-radius:8px;padding:8px 10px;font-size:11px;color:#514d48}
@media(max-width:600px){.brand{font-size:14px}.version-stamp{font-size:9px}.camera-dock{top:calc(max(12px,env(safe-area-inset-top)) + 58px)}.camera-dock button{min-width:51px;height:38px;font-size:16px}.camera-dock button span{font-size:9px}.status{max-width:125px}}

/* v0.3.2: saved-room repair and safe selection controls */
.object-list{max-height:110px;overflow:auto;border:1px solid #e1ddd7;border-radius:10px;background:#faf9f6;margin-top:8px}
.object-entry{display:flex;align-items:center;gap:5px;padding:5px 7px;border-bottom:1px solid #ece9e3}
.object-entry:last-child{border-bottom:0}.object-entry.active{background:#e9eee9}
.object-pick{flex:1;text-align:left;background:none;border:0;color:#383735;font-size:11px;padding:6px 2px}
.object-remove{border:1px solid #dfc5c5;color:#9e5555;background:#fff;border-radius:7px;padding:6px 9px;font-size:11px}
.safe-toolbar{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}
.small.strong{background:#383735;color:white}
.history-controls{border-top:1px solid #e4dfd9;padding-top:9px;margin-top:10px}
.history-controls select{width:100%;max-width:100%;font-size:11px}
.field-note{font-size:10px;color:#79736e;line-height:1.6;margin:6px 0}
@media(max-width:600px){.editor.expanded{max-height:min(60dvh,530px)}.object-list{max-height:105px}}

/* v0.4 — clean architectural overlay / safe room framing */
.brand{letter-spacing:.045em}
.version-stamp{font-size:9px;letter-spacing:.08em}
.tool:focus-visible,.small:focus-visible,.icon-btn:focus-visible{outline:2px solid #7d8c86;outline-offset:2px}
@media(max-width:600px){.camera-dock{right:9px;gap:4px}.camera-dock button{min-width:45px;height:40px}.editor{box-shadow:0 8px 28px #4d44321c}}

/* v0.5 – quiet, usable fullscreen controls */
.brand{background:#fffffff0;font-size:clamp(16px,2.8vw,22px)}
.camera-dock{top:calc(max(14px,env(safe-area-inset-top)) + 68px);gap:7px}
.camera-dock button{width:51px;min-width:51px;height:47px;border-radius:15px;font-size:20px}
.camera-dock button span{font:10px 'Noto Serif JP',serif}
.editor{max-height:min(35dvh,320px)}.editor.expanded{max-height:min(51dvh,440px)}
.mode-switch{position:fixed;z-index:27;top:calc(max(14px,env(safe-area-inset-top)) + 69px);left:12px;display:flex;border:1px solid #ddd8d0;border-radius:14px;background:#ffffffed;backdrop-filter:blur(14px);padding:4px;gap:3px;box-shadow:0 7px 24px #1713090d}
.mode-switch button{border:0;background:transparent;color:#625e58;padding:11px 11px;border-radius:11px;font:600 11px Arial,sans-serif;letter-spacing:.06em;min-width:64px}
.mode-switch button.active{background:#3f4440;color:white}
.mode-help{position:fixed;z-index:9;bottom:calc(max(13px,env(safe-area-inset-bottom)) + 74px);left:50%;transform:translateX(-50%);max-width:80vw;background:#ffffffc9;border:1px solid #ffffffb9;border-radius:30px;padding:7px 14px;font-size:11px;color:#53514c;white-space:nowrap;pointer-events:none}
.life-pad{position:fixed;z-index:25;bottom:calc(max(18px,env(safe-area-inset-bottom)) + 94px);left:18px;display:grid;grid-template-columns:repeat(3,46px);grid-template-rows:repeat(2,46px);gap:5px;touch-action:none}
.life-pad button{border:1px solid #d6d4cf;background:#ffffffd9;backdrop-filter:blur(14px);border-radius:14px;font:19px Arial;color:#383735;touch-action:none;user-select:none;-webkit-user-select:none}
.life-pad button:active{background:#c9d5ca}.life-pad .up{grid-column:2;grid-row:1}.life-pad .left{grid-column:1;grid-row:2}.life-pad .down{grid-column:2;grid-row:2}.life-pad .right{grid-column:3;grid-row:2}
.life-action{position:fixed;z-index:25;right:16px;bottom:calc(max(18px,env(safe-area-inset-bottom)) + 107px);border:1px solid #d0d0c9;background:#fffffff0;border-radius:18px;padding:12px 17px;max-width:140px;font:13px 'Noto Serif JP',serif;color:#383735;box-shadow:0 5px 24px #22222218}
.life-clock{position:fixed;z-index:25;right:15px;top:calc(max(14px,env(safe-area-inset-top)) + 73px);background:#fffffff0;padding:9px 12px;border-radius:14px;border:1px solid #ddd8d0;font:12px Arial,sans-serif;letter-spacing:.06em}
body.life-mode .camera-dock,body.life-mode #editor,body.life-mode .actions,body.life-mode #status{display:none!important}
body.life-mode #toggleEdit{display:none}body.life-mode .bottom{bottom:max(14px,env(safe-area-inset-bottom))}
body.edit-mode .life-pad,body.edit-mode .life-action,body.edit-mode .life-clock{display:none!important}
body.edit-mode .mode-help{display:none}
body.life-mode .room-label{font-size:11px;padding:9px 12px}
@media(min-width:900px){.mode-switch{top:23px;left:50%;transform:translateX(-50%)}.life-pad{display:none}.mode-help{bottom:26px}.life-action{bottom:65px}.life-clock{right:20px;top:95px}}
@media(max-width:600px){.mode-switch{top:calc(max(14px,env(safe-area-inset-top)) + 61px)}body.life-mode .room-label{font-size:10px}.mode-help{bottom:calc(max(14px,env(safe-area-inset-bottom)) + 47px);font-size:10px}}
</style>
</head>
<body>
<div id="scene" role="application" aria-label="3Dルームビュー"></div>
<div class="topbar"><div class="brand">ROOMVERSE <span class="version-stamp">v0.5.0</span></div><div class="actions"><button class="icon-btn" id="undo" aria-label="元に戻す" title="元に戻す">↶</button><button class="icon-btn" id="redo" aria-label="やり直す" title="やり直す">↷</button><button class="icon-btn" id="save" aria-label="保存" title="保存">⌑</button><button class="icon-btn" id="resetView" aria-label="カメラ初期化" title="視点を戻す">⌖</button></div></div>
<div class="camera-dock"><button id="quickWindow" class="window-quick" aria-label="窓の景色を変更">◫ <span>景色</span></button><button id="focusWindow" aria-label="窓を見る">◉ <span>窓を見る</span></button><button id="cameraHome" aria-label="部屋全体に戻す">⌂ <span>HOME</span></button><button id="cameraTop" aria-label="真上から見る">▣ <span>TOP</span></button><button id="cameraZoomOut" aria-label="ズームアウト">− <span>OUT</span></button><button id="cameraZoomIn" aria-label="ズームイン">+ <span>IN</span></button></div>
<nav class="mode-switch" aria-label="モード切り替え"><button id="lifeMode" class="active" aria-pressed="true">LIFE</button><button id="editMode" aria-pressed="false">EDIT</button></nav>
<div class="life-clock" id="lifeClock">--:--</div><div class="mode-help" id="modeHelp">ドラッグで見渡す · 左下で移動</div>
<div class="life-pad" id="lifePad" aria-label="移動操作"><button class="up" data-walk="forward" aria-label="前進">↑</button><button class="left" data-walk="left" aria-label="左へ">←</button><button class="down" data-walk="back" aria-label="後退">↓</button><button class="right" data-walk="right" aria-label="右へ">→</button></div>
<button id="lifeAction" class="life-action" hidden>座る / 使う</button>
<div class="hint" id="hint">空間をドラッグして回転 · ピンチでズーム</div><div class="status" id="status">ローカル保存</div><div class="toast" id="toast" role="status"></div>
<div class="editor" id="editor"><div class="section-title"><span class="editor-title">ROOM EDITOR <span class="caption" id="selectionText">YOUR SPACE</span></span><span class="editor-top-right"><button class="drawer-toggle" id="expandPanel" title="パネルを拡大" aria-label="編集パネルを拡大">⤢</button><button class="drawer-toggle" id="collapsePanel" title="パネルをたたむ" aria-label="編集パネルを折りたたむ">⌄</button></span></div><div class="tabs"><button class="tab selected" data-tab="furniture">家具</button><button class="tab" data-tab="interior">内装</button><button class="tab" data-tab="lighting">照明</button><button class="tab" data-tab="window">景色</button></div><div id="panel"></div></div>
<div class="bottom"><div class="room-label">MY FIRST ROOM</div><button class="primary" id="toggleEdit">EDIT</button></div>
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/"}}</script>
<script type="module">
import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';
import {RoundedBoxGeometry} from 'three/addons/geometries/RoundedBoxGeometry.js';
const $=s=>document.querySelector(s), sceneHost=$('#scene');
const scene=new THREE.Scene();scene.background=new THREE.Color('#e9e6e0');
const camera=new THREE.PerspectiveCamera(48,innerWidth/innerHeight,.08,150); camera.position.set(11,8,14);
const renderer=new THREE.WebGLRenderer({antialias:true,alpha:false,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio,innerWidth<700?1.5:1.85));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.22;sceneHost.appendChild(renderer.domElement);
const controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.dampingFactor=.075;controls.target.set(0,.9,0);controls.minDistance=3.6;controls.maxDistance=34;controls.enableZoom=true;controls.zoomSpeed=0.85;controls.touches={ONE:THREE.TOUCH.ROTATE,TWO:THREE.TOUCH.DOLLY_PAN};controls.maxPolarAngle=Math.PI/2-.04;controls.enablePan=true;controls.screenSpacePanning=false;controls.update();
renderer.toneMappingExposure=1.08;scene.add(new THREE.HemisphereLight('#ffffff','#9f9991',1.55)); const sunlight=new THREE.DirectionalLight('#fff8ee',2.15);sunlight.position.set(-3,8,4);sunlight.castShadow=true;sunlight.shadow.mapSize.set(innerWidth<700?1024:2048,innerWidth<700?1024:2048);sunlight.shadow.camera.left=-11;sunlight.shadow.camera.right=11;sunlight.shadow.camera.top=11;sunlight.shadow.camera.bottom=-11;sunlight.shadow.bias=-.0006;sunlight.shadow.normalBias=.015;sunlight.shadow.radius=3;scene.add(sunlight);
const indoor=new THREE.PointLight('#ffdbad',.5,13); indoor.position.set(0,2.4,0);scene.add(indoor);
const mat=(color,roughness=.84,metalness=0)=>new THREE.MeshStandardMaterial({color,roughness,metalness});
function rounded(w,h,d,m,x,y,z,r=.07){let o=new THREE.Mesh(new RoundedBoxGeometry(w,h,d,3,Math.min(r,w/5,h/5,d/5)),m);o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;return o}
function makeTex(kind){const c=document.createElement('canvas');c.width=c.height=512;const a=c.getContext('2d');if(kind==='tile'){a.fillStyle='#e4e2df';a.fillRect(0,0,512,512);for(let y=0;y<512;y+=128)for(let x=0;x<512;x+=128){a.fillStyle=(((x+y)/128)%2)?'#e7e5e2':'#f0eeeb';a.fillRect(x+2,y+2,124,124);a.strokeStyle='#c9c6c1';a.strokeRect(x+1,y+1,126,126)}for(let i=0;i<70;i++){a.strokeStyle='rgba(180,176,172,.13)';a.lineWidth=1;a.beginPath();let x=(i*173)%512,y=(i*71)%512;a.moveTo(x,y);a.lineTo(x+((i*13)%100)-50,y+((i*23)%40)-20);a.stroke()}}else{a.fillStyle='#c8b49a';a.fillRect(0,0,512,512);for(let x=0;x<512;x+=53){a.fillStyle=x%2?'#c3ac91':'#d0b99e';a.fillRect(x+2,0,51,512);for(let j=0;j<8;j++){a.strokeStyle='rgba(75,50,28,.12)';a.beginPath();a.moveTo(x+((j*7)%50),0);a.bezierCurveTo(x+3,190,x+50,320,x+((j*9)%50),512);a.stroke()}}}const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(kind==='tile'?3:1,kind==='tile'?4:1);t.anisotropy=Math.min(renderer.capabilities.getMaxAnisotropy(),8);return t}

// v0.4: compact procedural PBR-compatible textures. No remote furniture assets required.
function surfaceTexture(kind){
 const c=document.createElement('canvas');c.width=c.height=512;const ctx=c.getContext('2d');
 const seed=(x,y)=>{const n=Math.sin(x*127.1+y*311.7)*43758.5453;return n-Math.floor(n)};
 if(kind==='fabric'){
  ctx.fillStyle='#e5e1da';ctx.fillRect(0,0,512,512);
  for(let i=0;i<512;i+=3){ctx.strokeStyle='rgba(110,100,90,.09)';ctx.lineWidth=.7;ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,512);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i);ctx.lineTo(512,i);ctx.stroke()}
  for(let i=0;i<1800;i++){const x=seed(i,4)*512,y=seed(i,7)*512;ctx.fillStyle=seed(i,9)>.5?'#ffffff12':'#726d630b';ctx.fillRect(x,y,1.7,1.7)}
 } else if(kind==='marble'){
  ctx.fillStyle='#eeeae3';ctx.fillRect(0,0,512,512);
  for(let j=0;j<40;j++){const y=seed(j,1)*512;ctx.strokeStyle=j%3===0?'rgba(130,125,118,.24)':'rgba(145,142,135,.08)';ctx.lineWidth=j%4===0?2:.8;ctx.beginPath();ctx.moveTo(-40,y);for(let x=0;x<=560;x+=12){const k=Math.sin(x*.019+j)*15+Math.sin(x*.06+j*3)*4;ctx.lineTo(x,y+k+x*.15)}ctx.stroke()}
 } else if(kind==='stone'){
  ctx.fillStyle='#e9e6df';ctx.fillRect(0,0,512,512);
  for(let i=0;i<7200;i++){const x=seed(i,3)*512,y=seed(i,7)*512;ctx.fillStyle=seed(i,8)>.52?'rgba(255,255,255,.13)':'rgba(79,76,70,.045)';ctx.fillRect(x,y,2,2)}
 }else if(kind==='walnut'){
  ctx.fillStyle='#b29c86';ctx.fillRect(0,0,512,512);
  for(let j=0;j<95;j++){let x=seed(j,2)*512;ctx.strokeStyle=j%4===0?'rgba(64,40,20,.16)':'rgba(254,245,221,.15)';ctx.lineWidth=.5+seed(j,3)*2;ctx.beginPath();ctx.moveTo(x,0);ctx.bezierCurveTo(x-20,160,x+22,320,x+Math.sin(j)*8,512);ctx.stroke()}
 }
 const tex=new THREE.CanvasTexture(c);tex.colorSpace=THREE.SRGBColorSpace;tex.wrapS=tex.wrapT=THREE.RepeatWrapping;tex.anisotropy=Math.min(renderer.capabilities.getMaxAnisotropy(),8);return tex;
}
const fabricTex=surfaceTexture('fabric'),marbleTex=surfaceTexture('marble'),stoneTex=surfaceTexture('stone'),walnutTex=surfaceTexture('walnut');
function textile(color='#ffffff'){return new THREE.MeshStandardMaterial({color,map:fabricTex,roughness:1,metalness:0})}
function woodPBR(color='#e6d2bb'){return new THREE.MeshStandardMaterial({color,map:walnutTex,roughness:.62})}
function stonePBR(color='#ffffff'){return new THREE.MeshStandardMaterial({color,map:marbleTex,roughness:.28,metalness:.015})}
function ceramic(color='#eee9e2'){return new THREE.MeshStandardMaterial({color,roughness:.26,metalness:.02})}
function cylinder(rtop,rbot,h,m,x,y,z,seg=24){const o=new THREE.Mesh(new THREE.CylinderGeometry(rtop,rbot,h,seg),m);o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;return o}
const tileMap=makeTex('tile'), woodMap=makeTex('wood');
function exteriorTexture(view){const c=document.createElement('canvas');c.width=1024;c.height=512;const g=c.getContext('2d');const pal={cityday:['#a6d2eb','#f4f1e9','#8b959d'],citynight:['#14243a','#596b89','#202c3f'],sunset:['#e7a98d','#f9dabb','#695970'],forest:['#9bc4ad','#e5ebd6','#507c59'],ocean:['#89c7e1','#dae9e5','#2d83a8'],rainy:['#8395a2','#d3d6d4','#6f7b84']}[view]||['#a6d2eb','#f4f1e9','#8b959d'];let grad=g.createLinearGradient(0,0,0,512);grad.addColorStop(0,pal[0]);grad.addColorStop(.62,pal[1]);grad.addColorStop(1,pal[2]);g.fillStyle=grad;g.fillRect(0,0,1024,512);if(['cityday','citynight','sunset','rainy'].includes(view)){for(let i=0;i<62;i++){const x=i*19-10,h=42+(i*37)%148;g.fillStyle=view==='citynight'?['#273345','#35435c','#1b2a3b'][i%3]:['#aab3b4','#8e9ca4','#bac0bd'][i%3];g.fillRect(x,385-h,16+((i*5)%14),h);for(let wx=x+4;wx<x+16;wx+=6)for(let wy=390-h+8;wy<380;wy+=13){g.fillStyle=view==='citynight'&&((wx*wy)%3)?'#edcb90':'#e5e6de';g.globalAlpha=view==='citynight'?.85:.18;g.fillRect(wx,wy,2,4);g.globalAlpha=1}}}else if(view==='forest'){for(let j=0;j<70;j++){let x=j*17,hh=90+(j*73)%160;g.fillStyle=j%3===0?'#385b48':'#60836a';g.beginPath();g.moveTo(x,380-hh);g.lineTo(x-40,399);g.lineTo(x+44,399);g.fill()}}else if(view==='ocean'){g.fillStyle='#4e9cb8';g.fillRect(0,320,1024,192);for(let i=0;i<80;i++){g.strokeStyle='rgba(255,255,255,.35)';g.beginPath();g.moveTo((i*79)%1024,341+(i*37)%153);g.lineTo((i*79)%1024+20,341+(i*37)%153);g.stroke()}}if(view==='rainy'){for(let i=0;i<130;i++){g.strokeStyle='rgba(235,241,242,.28)';g.beginPath();g.moveTo((i*87)%1024,(i*39)%512);g.lineTo((i*87)%1024-6,(i*39)%512+32);g.stroke()}}let t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t}
 const quartz=mat('#f1eee8'),oak=mat('#b8a18a'),side=mat('#ded8cf');
function box(w,h,d,m,x,y,z,cast=true){const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);o.position.set(x,y,z);o.castShadow=cast;o.receiveShadow=true;return o}
const room=new THREE.Group();scene.add(room);
const floor=box(6,.16,8,oak,0,-.08,0,false);room.add(floor);
const back=box(6,.50,.13,quartz,0,.25,-4,false);room.add(back);
room.add(box(6,.50,.13,quartz,0,2.55,-4,false));
room.add(box(1.12,1.8,.13,quartz,-2.44,1.4,-4,false));room.add(box(1.12,1.8,.13,quartz,2.44,1.4,-4,false));
const left=box(.13,2.8,8,quartz,-3,1.4,0,false);room.add(left);
const ceiling=box(6,.06,8,mat('#f8f7f4'),0,2.83,0,false);ceiling.visible=false;room.add(ceiling);
const trim=mat('#e5e3e0');room.add(box(6,.065,.09,trim,0,.06,-3.88,false));room.add(box(.09,.065,8,trim,-2.88,.06,0,false));
for(const x of [-1.88,0,1.88])room.add(box(.055,1.85,.08,mat('#bdbdbb',.28,.65),x,1.4,-3.88,false));
room.add(box(3.8,.055,.09,mat('#bebeba',.28,.5),0,2.31,-3.88,false));room.add(box(3.8,.07,.12,mat('#e5e2df'),0,.48,-3.88,false));
const outdoor=new THREE.Mesh(new THREE.PlaneGeometry(4.75,2.4),new THREE.MeshBasicMaterial({map:exteriorTexture('cityday'),side:THREE.DoubleSide}));outdoor.position.set(0,1.4,-4.08);room.add(outdoor);
const glass=new THREE.Mesh(new THREE.PlaneGeometry(3.75,1.82),new THREE.MeshPhysicalMaterial({color:'#d7e5ea',metalness:0,roughness:.08,transparent:true,opacity:.10,depthWrite:false,side:THREE.DoubleSide}));glass.position.set(0,1.42,-3.78);room.add(glass);
const tv=box(.055,.95,1.5,mat('#17191c',.22,.15),-2.86,1.65,-1.4,false);room.add(tv);tv.visible=false;
const tvScreen=box(.028,.84,1.37,mat('#303538',.23,.12),-2.81,1.65,-1.4,false);room.add(tvScreen);tvScreen.visible=false;
room.add(rounded(.48,.47,1.7,mat('#c5c0b8',.5),-2.64,.29,-1.4,.025));
for(let x=-2.5;x<2.6;x+=1.15)for(let z=-3.55;z<3.8;z+=1.35){const inset=new THREE.Mesh(new THREE.CylinderGeometry(.065,.065,.008,16),new THREE.MeshBasicMaterial({color:'#e7dac0'}));inset.position.set(x,2.79,z);room.add(inset)}
const accent=box(.02,2.25,1.7,mat('#5e5d5b',.94),-2.92,1.42,-1.45,false);accent.visible=false;room.add(accent);
// v0.4 architectural details, kept separate from editable objects.
const ivoryPaint=mat('#f4f1ea',.92), shadowTrim=mat('#d0cbc3',.78),bronzeNeutral=mat('#7f817e',.48,.25);
// Four-sided window frame; previous exterior switching remains compatible.
