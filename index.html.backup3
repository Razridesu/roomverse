 const lightDisc=cylinder(.060,.060,.014,new THREE.MeshStandardMaterial({color:'#fff4df',emissive:'#ffe8be',emissiveIntensity:.36,roughness:.8}),x,2.793,z,20);room.add(lightDisc);
}
// Discrete skirting and wall finish details.
room.add(box(6,.11,.025,ivoryPaint,0,.065,-3.905,false));
room.add(box(.025,.11,7.8,ivoryPaint,-2.91,.065,0,false));
const galleryPanel=box(.035,1.75,1.26,mat('#e1ded8',.83),-2.915,1.52,1.35,false);room.add(galleryPanel);
