room.add(rounded(.035,.24,.13,new THREE.MeshStandardMaterial({color:'#f9f4e8',emissive:'#f9e4c8',emissiveIntensity:.25}),-2.81,1.74,2.3,.015));

function createFurniture(type){
 const g=new THREE.Group();g.userData.type=type;
 const linen=textile('#f9f7f4'),warmFabric=textile('#eee8df'),darkFabric=textile('#cdc7bf');
 const ash=woodPBR('#e2d6c9'), darkWood=woodPBR('#938175'),steel=mat('#606361',.4,.3),
       marble=stonePBR('#f8f6f2'),ceram=ceramic('#ded8cf');
 function put(x){g.add(x);return x}
 if(type==='sofa'){
  // Three cushion sofa with soft rolled edges, piping and discreet feet.
  put(rounded(2.12,.27,.94,warmFabric,0,.43,0,.095));
  put(rounded(2.13,.66,.23,warmFabric,0,.68,-.42,.095));
  for(const x of [-.74,0,.74]){
   put(rounded(.66,.19,.76,linen,x,.62,.055,.075));
   put(rounded(.61,.51,.17,linen,x,.83,-.38,.058));
  }
  for(const x of [-1.04,1.04]){
   put(rounded(.21,.43,.91,darkFabric,x,.51,0,.08));
   for(const z of [-.33,.32])put(rounded(.10,.13,.11,darkWood,x,.14,z,.018));
  }
  // Subtle textile pillows, retained in the furniture group for move/delete.
  const a=put(rounded(.28,.30,.11,textile('#c4d0c7'),-.7,.82,-.25,.05));a.rotation.z=-.21;
  const b=put(rounded(.26,.28,.10,textile('#dbd0c0'),.72,.84,-.26,.05));b.rotation.z=.2;
 } else if(type==='table'){
  put(rounded(1.24,.085,.72,marble,0,.47,0,.032));
  put(rounded(1.05,.055,.57,ash,0,.35,0,.02));
  for(const x of [-.51,.51])for(const z of [-.24,.24])put(rounded(.047,.41,.047,steel,x,.22,z,.008));
  put(cylinder(.082,.085,.115,ceram,.24,.59,-.08));
 } else if(type==='plant'){
  put(cylinder(.20,.145,.39,ceram,0,.20,0,24));
  put(cylinder(.17,.17,.025,mat('#756b5c'),0,.405,0));
  put(cylinder(.022,.038,.72,mat('#796954'),0,.77,0,12));
  const leafMats=[new THREE.MeshStandardMaterial({color:'#416e4a',side:THREE.DoubleSide,roughness:.77}),new THREE.MeshStandardMaterial({color:'#628f5d',side:THREE.DoubleSide,roughness:.8}),new THREE.MeshStandardMaterial({color:'#315b43',side:THREE.DoubleSide,roughness:.76})];
  function blade(length,width,variant){
   const N=14,verts=[],indices=[],colors=[];
   for(let i=0;i<=N;i++){
     const t=i/N, ww=Math.pow(Math.sin(Math.PI*t),.82)*width;
     for(const sign of [-1,1]){
       const x=sign*ww*(1+Math.sin(t*10+variant)*.035),y=.09*Math.sin(Math.PI*t)+Math.sin(t*9+variant)*.007,z=t*length;
       verts.push(x,y,z);colors.push(1,1,1);
     }
   }
   for(let i=0;i<N;i++){const j=i*2;indices.push(j,j+1,j+2,j+1,j+3,j+2)}
   const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));geo.setIndex(indices);geo.computeVertexNormals();return geo;
  }
  for(let k=0;k<23;k++){
    const angle=k*2.39996, level=k/23;
    const stalkLength=.28+.33*(1-level);
    const height=.55+.48*level;
    const stem=put(cylinder(.007,.015,stalkLength,mat('#527148',.9),Math.cos(angle)*.07,height,Math.sin(angle)*.07,6));
    stem.rotation.z=.18*Math.cos(angle);
    const leaf=new THREE.Mesh(blade(.28+.23*(1-level),.065+.045*(1-level),k),leafMats[k%3]);
    leaf.position.set(Math.cos(angle)*(.11+.18*(1-level)),height+stalkLength*.43,Math.sin(angle)*(.11+.18*(1-level)));
    leaf.rotation.y=angle;leaf.rotation.x=-.28-.34*(1-level);leaf.rotation.z=Math.sin(k*4.7)*.11;
    leaf.castShadow=true;leaf.receiveShadow=true;put(leaf);
    const midrib=put(box(.003,.004,.23,mat('#8aac78',.9),leaf.position.x,leaf.position.y+.012,leaf.position.z+.13));midrib.rotation.y=angle;
  }
 } else if(type==='bed'){
  put(rounded(1.78,.23,2.28,ash,0,.28,0,.055));
  put(rounded(1.64,.18,2.12,linen,0,.49,.02,.05));
  put(rounded(1.8,.89,.14,warmFabric,0,.66,-1.12,.045));
  put(rounded(1.62,.075,1.21,textile('#d2d0cb'),0,.62,.41,.03));
  put(rounded(1.62,.065,.42,textile('#c4c6c3'),0,.63,.80,.03));
  // Contoured fabric surface: uneven folds instead of one flat box.
  const cols=18,rows=24,v=[],uv=[],faces=[];
  for(let z=0;z<=rows;z++)for(let x=0;x<=cols;x++){
    const tx=x/cols,tz=z/rows;
    const fold=Math.sin(tx*23+tz*5)*.024+Math.sin(tz*17+tx*3)*.021;
    v.push((tx-.5)*1.57,.687+fold+Math.sin(Math.PI*tx)*.025,(-.12+tz*1.13));uv.push(tx,tz);
  }
  for(let z=0;z<rows;z++)for(let x=0;x<cols;x++){let a=z*(cols+1)+x,b=a+cols+1;faces.push(a,b,a+1,a+1,b,b+1)}
  const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(v,3));geo.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));geo.setIndex(faces);geo.computeVertexNormals();
  const duvet=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color:'#c4c8bf',roughness:1,side:THREE.DoubleSide,map:fabricTex}));duvet.castShadow=true;put(duvet);

  for(const x of [-.42,.42]){
   const pillow=put(rounded(.7,.13,.39,linen,x,.67,-.70,.07));pillow.rotation.z=x>0?.045:-.045;
  }
  for(const x of [-.72,.72])for(const z of [-.93,.93])put(rounded(.075,.13,.075,darkWood,x,.10,z,.012));
 }else if(type==='desk'){
  put(rounded(1.7,.09,.77,ash,0,.75,0,.025));
  for(const x of [-.73,.73])for(const z of [-.30,.30])put(box(.055,.72,.055,steel,x,.38,z));
  put(rounded(.76,.46,.036,mat('#30363a',.21,.1),0,1.09,-.21,.012));
  put(rounded(.67,.36,.019,new THREE.MeshBasicMaterial({color:'#b7c7c9'}),0,1.09,-.183,.007));
  put(box(.04,.2,.04,steel,0,.81,-.19));
  put(rounded(.51,.015,.17,mat('#dedbd7'),0,.82,.15,.008));
 }else if(type==='chair'){
  put(rounded(.62,.15,.63,linen,0,.49,0,.052));
  put(rounded(.64,.66,.13,warmFabric,0,.85,-.27,.048));
  for(const x of [-.24,.24])for(const z of [-.23,.23])put(rounded(.045,.47,.045,darkWood,x,.24,z,.009));
  for(const x of [-.31,.31])put(rounded(.06,.21,.45,ash,x,.64,-.02,.016));
 }else if(type==='lamp'){
  put(cylinder(.23,.25,.06,steel,0,.036,0));
  put(cylinder(.019,.024,1.53,steel,0,.79,0,12));
  put(cylinder(.29,.19,.36,linen,0,1.65,0,28));
  put(cylinder(.17,.17,.015,new THREE.MeshStandardMaterial({color:'#fff1da',emissive:'#ffe2ae',emissiveIntensity:.4}),0,1.48,0));
 }else if(type==='cabinet'){
  put(rounded(1.49,.63,.50,darkWood,0,.47,0,.027));
  put(rounded(1.54,.07,.54,marble,0,.82,0,.018));
  for(const x of [-.36,.36]){
   put(rounded(.68,.45,.024,ash,x,.48,.27,.012));
   put(rounded(.13,.015,.018,steel,x,.49,.29,.004));
  }
  for(const x of [-.58,.58])put(box(.065,.16,.065,steel,x,.085,0));
 }else if(type==='rug'){
  const rug=new THREE.Mesh(new THREE.PlaneGeometry(2.36,1.56),textile('#ece9e3'));rug.rotation.x=-Math.PI/2;rug.position.y=.013;rug.receiveShadow=true;put(rug);
  for(let i=-5;i<=5;i++){put(box(2.27,.003,.006,mat('#c5c2b9',1),0,.018,i*.12))}
 }else if(type==='art'){
  put(rounded(1.05,.91,.05,darkWood,0,1.28,0,.012));
  const canvas=put(box(.96,.82,.012,mat('#e8e6e1',1),0,1.28,.038));
  const a=put(rounded(.65,.55,.006,mat('#b1bbb0',1),-.09,1.30,.048,.004));a.rotation.z=-.1;
  const b=put(rounded(.44,.25,.007,mat('#d7c1aa',1),.15,1.09,.055,.004));b.rotation.z=.23;
 }
 g.traverse(o=>{if(o.isMesh){o.castShadow=type!=='rug';o.receiveShadow=true}});return g;
}
const objects=[];let timeMode='real',customHour=16,lifeLightOn=true,sceneCategory='ocean';const defaults=[{id:1,type:'sofa',x:-.85,z:-1.45,r:0},{id:2,type:'table',x:-.65,z:.17,r:0},{id:3,type:'plant',x:1.65,z:-2.75,r:0}];
let nextId=4,selection=null,editing=false,tab='furniture',moveMode=false,dragging=false,oldDrag=null,undoStack=[],redoStack=[],lightStrength=60,wallName='quartz',floorName='oak',timeOfDay='day',windowView='cityday',panelExpanded=false,panelCollapsed=false;
// Keep all saved furniture inside walls, accounting for actual rotated dimensions.
function worldBox(group){group.updateMatrixWorld(true);return new THREE.Box3().setFromObject(group)}
function keepInside(group){
  const b=worldBox(group); if(b.isEmpty())return;
  const pad=.13, minX=-2.93+pad,maxX=2.93-pad,minZ=-3.93+pad,maxZ=3.93-pad;
  const halfX=(b.max.x-b.min.x)/2,halfZ=(b.max.z-b.min.z)/2;
  const cx=(b.min.x+b.max.x)/2,cz=(b.min.z+b.max.z)/2;
  const destX=THREE.MathUtils.clamp(cx,minX+halfX,maxX-halfX),destZ=THREE.MathUtils.clamp(cz,minZ+halfZ,maxZ-halfZ);
  group.position.x+=destX-cx;group.position.z+=destZ-cz;
  group.updateMatrixWorld(true);
}
function overlapsFurniture(a,b){
 if(a===b||['rug','art'].includes(a.userData.type)||['rug','art'].includes(b.userData.type))return false;
 const aa=worldBox(a),bb=worldBox(b);const pad=.025;
 return aa.min.x<bb.max.x-pad&&aa.max.x>bb.min.x+pad&&aa.min.z<bb.max.z-pad&&aa.max.z>bb.min.z+pad;
}
function freeSpot(group){
 keepInside(group);
 if(!objects.some(o=>overlapsFurniture(o,group)))return true;
 const initialX=group.position.x,initialZ=group.position.z;
 for(let radius=.5;radius<=5.2;radius+=.5){
   for(let a=0;a<24;a++){
    const angle=a*Math.PI/12;group.position.set(initialX+Math.cos(angle)*radius,0,initialZ+Math.sin(angle)*radius);keepInside(group);
    if(!objects.some(o=>overlapsFurniture(o,group)))return true;
   }
 }
 group.position.set(initialX,0,initialZ);keepInside(group);return false;
}
function removeFurniture(target){if(!target)return; snapshot();scene.remove(target);objects.splice(objects.indexOf(target),1);if(selection===target){selection=null;moveMode=false}renderPanel();scheduleSave();notify('家具を削除しました。元に戻すこともできます')}
function repairLayout(){snapshot();let moved=0;const ordered=[];
 for(const o of objects){const before=o.position.clone();keepInside(o);
   if(ordered.some(other=>overlapsFurniture(o,other))){
     const x=o.position.x,z=o.position.z;let fixed=false;
     for(let r=.45;r<=6&&!fixed;r+=.45)for(let a=0;a<32&&!fixed;a++){
       const angle=a*Math.PI/16;o.position.set(x+r*Math.cos(angle),0,z+r*Math.sin(angle));keepInside(o);
       if(!ordered.some(other=>overlapsFurniture(o,other)))fixed=true;
     }
     if(!fixed){o.position.set(x,0,z);keepInside(o)}
   }
   if(before.distanceTo(o.position)>.01)moved++;ordered.push(o)
 }
 renderPanel();scheduleSave();notify(moved+'件の位置を補正しました。元に戻すこともできます')}

function addObject(data){const g=createFurniture(data.type);g.userData.id=data.id;g.position.set(data.x,0,data.z);g.rotation.y=data.r||0;scene.add(g);objects.push(g);keepInside(g);return g}
function serialize(){return{objects:objects.map(o=>({id:o.userData.id,type:o.userData.type,x:Number(o.position.x.toFixed(3)),z:Number(o.position.z.toFixed(3)),r:Number(o.rotation.y.toFixed(3))})),lightStrength,wallName,floorName,timeOfDay,windowView,timeMode,customHour,sceneCategory}}
function apply(data){for(const o of objects)scene.remove(o);objects.length=0;for(const d of data.objects||defaults)addObject(d);nextId=Math.max(4,...objects.map(o=>o.userData.id+1));lightStrength=data.lightStrength??60;wallName=data.wallName||'quartz';floorName=data.floorName||'oak';timeOfDay=data.timeOfDay||'day';windowView=data.windowView||'cityday';timeMode=data.timeMode||'real';customHour=data.customHour??16;sceneCategory=data.sceneCategory||(['ocean','forest'].includes(windowView)?windowView:'city');refreshClock();applyMaterials();selection=null;renderPanel()}
function applyMaterials(){const actualHour=timeMode==='real'?new Date().getHours():Number(customHour);timeOfDay=actualHour<6||actualHour>=19?'night':actualHour>=16?'sunset':'day';windowView=sceneCategory==='city'?(timeOfDay==='night'?'citynight':timeOfDay==='sunset'?'sunset':'cityday'):sceneCategory;const walls={quartz:'#f1eee8',ivory:'#e1d8cd',stone:'#d3d1cb',linen:'#f9f7f1',concrete:'#b8b8b4'};const floors={oak:'#b8a18a',light:'#d9c9b7',stone:'#d1d1cc',walnut:'#786252',quartz:'#e8e4dd'};quartz.color.set(walls[wallName]||walls.quartz);quartz.map=stoneTex;quartz.needsUpdate=true;oak.color.set(floors[floorName]||floors.oak);if(oak.map){oak.map=null}oak.color.set(floors[floorName]||floors.oak);if(['quartz','stone'].includes(floorName)){oak.map=marbleTex;oak.color.set(floorName==='quartz'?'#ffffff':'#e9e8e5');oak.roughness=.27;oak.metalness=.02}else if(['oak','light','walnut'].includes(floorName)){oak.map=walnutTex;oak.color.set(floorName==='walnut'?'#8b7867':'#e5d2b8');oak.roughness=.64;oak.metalness=0}oak.needsUpdate=true;outdoor.material.map?.dispose();outdoor.material.map=exteriorTexture(windowView);outdoor.material.needsUpdate=true;const intensity={day:1,sunset:.56,night:.13}[timeOfDay]||1;indoor.intensity=lightStrength/100*(timeOfDay==='night'?2.8:1.25);sunlight.intensity=(.9+lightStrength/100*1.8)*intensity;sunlight.color.set(timeOfDay==='sunset'?'#ffd2aa':timeOfDay==='night'?'#afc2db':'#fff6e9');scene.background.set(timeOfDay==='night'?'#a8aab0':timeOfDay==='sunset'?'#e5d3c2':'#e8e4dd');sunlight.intensity*=windowView==='citynight'?.2:windowView==='rainy'?.55:1;indoor.intensity+=windowView==='citynight'?.7:0;if(!lifeLightOn)indoor.intensity=0;}
function snapshot(){undoStack.push(JSON.stringify(serialize()));if(undoStack.length>60)undoStack.shift();redoStack=[];refreshUndo()}
function restore(stackFrom,stackTo){if(!stackFrom.length)return;stackTo.push(JSON.stringify(serialize()));apply(JSON.parse(stackFrom.pop()));refreshUndo();scheduleSave()}
function refreshUndo(){$('#undo').disabled=!undoStack.length;$('#redo').disabled=!redoStack.length}
let saveTimer;function scheduleSave(){$('#status').textContent='未保存の変更';clearTimeout(saveTimer);saveTimer=setTimeout(saveNow,950)}
function saveNow(){try{
 const data=JSON.stringify(serialize());const key='roomverse-prototype-v3',previous=localStorage.getItem(key);
 if(previous&&previous!==data){let history=JSON.parse(localStorage.getItem('roomverse-history-v032')||'[]');
   if(history.at(-1)?.data!==previous){history.push({at:new Date().toISOString(),data:previous});history=history.slice(-15);localStorage.setItem('roomverse-history-v032',JSON.stringify(history));}}
 localStorage.setItem(key,data);$('#status').textContent='この端末に保存済み';notify('保存しました（過去15件まで復元可能）');
}catch(e){$('#status').textContent='保存に失敗しました';notify('保存容量などを確認してください')}}
function exportRoom(){const data=JSON.stringify(serialize(),null,2);const file=new Blob([data],{type:'application/json'});const url=URL.createObjectURL(file);const link=document.createElement('a');link.href=url;link.download='roomverse-room-backup.json';document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),4000);notify('バックアップファイルを出力しました')}
function restoreBackup(){const sel=$('#historySelect');if(!sel||!sel.value)return;let history=JSON.parse(localStorage.getItem('roomverse-history-v032')||'[]');let item=history[Number(sel.value)];if(!item)return;
 if(!confirm('選択した時点の配置に戻しますか？現在の配置は履歴に保存されます。'))return;
 snapshot();const current=localStorage.getItem('roomverse-prototype-v3');if(current){history.push({at:new Date().toISOString(),data:current});localStorage.setItem('roomverse-history-v032',JSON.stringify(history.slice(-15)))}
 apply(JSON.parse(item.data));scheduleSave();notify('保存履歴から復元しました');}

let toastTimer;function notify(t){$('#toast').textContent=t;$('#toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').classList.remove('show'),1700)}
function selectObject(o){selection=o;renderPanel();highlight()}
const selectionMat=mat('#7d9789');function highlight(){objects.forEach(o=>o.traverse(child=>{if(child.isMesh&&child.userData.outline){o.remove(child)}}))}
const names={sofa:'ソファ',table:'テーブル',plant:'観葉植物',bed:'ベッド',desk:'デスク',chair:'チェア',lamp:'フロアライト',cabinet:'キャビネット',rug:'ラグ',art:'アート'};
function furniturePanel(){
 const rows=objects.map(o=>`<div class="object-entry ${selection===o?'active':''}"><button class="object-pick" data-pick="${o.userData.id}">${names[o.userData.type]||o.userData.type} · ID ${o.userData.id}</button><button class="object-remove" data-remove="${o.userData.id}" aria-label="ID ${o.userData.id} を削除">削除</button></div>`).join('');
 const history=JSON.parse(localStorage.getItem('roomverse-history-v032')||'[]');
 return `<div class="tools">${[['sofa','▱'],['table','▤'],['plant','♧'],['bed','▥'],['desk','▱'],['chair','♙'],['lamp','☼'],['cabinet','▤'],['rug','▭'],['art','▣']].map(([id,icon])=>`<button class="tool" data-add="${id}"><em>${icon}</em>${names[id]}を追加</button>`).join('')}</div>
 <div class="safe-toolbar"><button class="small strong" id="showObjects">配置一覧を表示（${objects.length}件）</button><button class="small" id="repair">重なり・貫通を整理</button></div>
 <div id="objectSection" style="display:none"><p class="field-note">家具を一覧から選択・削除できます。保存済みの配置も編集可能です。</p><div class="object-list">${rows||'<p class="field-note">配置された家具はありません</p>'}</div></div>
 ${selection?`<div style="height:8px"></div><div class="row"><b style="font-size:12px">選択中：${names[selection.userData.type]}</b><span class="caption">ID ${selection.userData.id}</span></div><div class="sub-actions"><button class="small ${moveMode?'active':''}" id="move">${moveMode?'✓ 移動中':'⇄ 移動'}</button><button class="small" id="rotateL">↶ 左回転</button><button class="small" id="rotateR">↷ 右回転</button><button class="small" id="duplicate">⊕ 複製</button><button class="small danger" id="delete">この家具を削除</button></div><p class="caption panel-note">家具は一覧からも選べます。移動はボタンを押してから。</p>`:`<p class="caption panel-note">家具を追加するか「配置一覧」を開いて選択。</p>`}
 <div class="history-controls"><button class="small" id="exportRoom">現在の部屋をバックアップ</button><div class="caption">保存履歴（最大15件）</div><div class="field"><select id="historySelect" aria-label="保存履歴"><option value="">復元する履歴を選択</option>${history.map((h,i)=>`<option value="${i}">${new Date(h.at).toLocaleString('ja-JP')}</option>`).join('')}</select><button id="restoreHistory" class="small">復元</button></div><button class="small" id="restoreOriginal">v0.3.1以前の配置へ戻す</button><p class="field-note">以前のバージョンで上書きされた履歴は復元できません。現在の配置は引き継ぎます。</p></div>`;
}
function interiorPanel(){return `<div class="field"><label>壁材</label><select id="wall"><option value="quartz" ${wallName==='quartz'?'selected':''}>QUARTZ WHITE</option><option value="linen" ${wallName==='linen'?'selected':''}>LINEN WHITE</option><option value="ivory" ${wallName==='ivory'?'selected':''}>WARM IVORY</option><option value="stone" ${wallName==='stone'?'selected':''}>STONE GRAY</option><option value="concrete" ${wallName==='concrete'?'selected':''}>SOFT CONCRETE</option></select></div><div class="field"><label>床材</label><select id="floor"><option value="oak" ${floorName==='oak'?'selected':''}>NATURAL OAK</option><option value="light" ${floorName==='light'?'selected':''}>LIGHT WOOD</option><option value="stone" ${floorName==='stone'?'selected':''}>LIGHT STONE</option><option value="walnut" ${floorName==='walnut'?'selected':''}>WALNUT</option><option value="quartz" ${floorName==='quartz'?'selected':''}>QUARTZ</option></select></div>`}
function lightingPanel(){return `<div class="caption">光の時間帯</div><div class="setting-row">${[['day','DAY'],['sunset','SUNSET'],['night','NIGHT']].map(([id,t])=>`<button class="setting-chip ${timeOfDay===id?'selected':''}" data-time="${id}">${t}</button>`).join('')}</div><div class="field"><label>明るさ：<span id="lightValue">${lightStrength}%</span></label><input id="light" type="range" min="10" max="100" value="${lightStrength}"/></div><p class="caption panel-note">昼・夕方・夜と室内の明るさを調整。</p>`}
function windowPanel(){return `<div class="caption">WINDOW VIEW · 窓の外を変更</div><div class="field"><label>時間設定</label><select id="timeMode"><option value="real" ${timeMode==='real'?'selected':''}>現実の時刻に同期</option><option value="manual" ${timeMode==='manual'?'selected':''}>時間を指定</option></select></div>${timeMode==='manual'?`<div class="field"><label>時刻 <span id="hourText">${String(customHour).padStart(2,'0')}:00</span></label><input type="range" id="customHour" min="0" max="23" value="${customHour}"/></div>`:''}<div class="window-options">${[['cityday','CITY DAY','街・昼'],['citynight','CITY NIGHT','街・夜'],['sunset','SUNSET','夕焼け'],['forest','FOREST','森林'],['ocean','OCEAN','海'],['rainy','RAINY','雨']].map(([id,en,ja])=>`<button class="window-option ${windowView===id?'selected':''}" data-window="${id}">${ja}<small>${en}</small></button>`).join('')}</div><button class="window-corner" id="lookAtWindow">◉ 窓の方向を見る</button><p class="window-hint">室内の奥の壁に窓があります。景色を押すと切り替わります。</p>`}
function renderPanel(){document.querySelectorAll('.tab').forEach(e=>e.classList.toggle('selected',e.dataset.tab===tab));$('#selectionText').textContent=selection?'OBJECT SELECTED':'YOUR SPACE';$('#panel').innerHTML=tab==='furniture'?furniturePanel():tab==='interior'?interiorPanel():tab==='lighting'?lightingPanel():windowPanel();if(tab==='furniture'){
 const section=$('#objectSection');$('#showObjects').onclick=()=>{section.style.display=section.style.display==='none'?'block':'none'; if(section.style.display==='block'){panelExpanded=true;panelCollapsed=false;updateDrawer()}};
 $('#repair').onclick=repairLayout;
 document.querySelectorAll('[data-pick]').forEach(b=>b.onclick=()=>{const target=objects.find(o=>o.userData.id===Number(b.dataset.pick));if(target){selectObject(target);panelExpanded=true;updateDrawer();}});
 document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{const target=objects.find(o=>o.userData.id===Number(b.dataset.remove));if(target)removeFurniture(target)});
 $('#restoreHistory').onclick=restoreBackup;$('#exportRoom').onclick=exportRoom;$('#restoreOriginal').onclick=()=>{const original=localStorage.getItem('roomverse-pre032-original');if(!original){notify('以前の保存データは見つかりません');return}if(confirm('アップデート時点の配置に戻しますか？')){snapshot();apply(JSON.parse(original));scheduleSave();notify('アップデート前の配置に戻しました')}};
 }
 $('#panel').querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{snapshot();const item=addObject({id:nextId++,type:b.dataset.add,x:0,z:.9,r:0});freeSpot(item);selectObject(item);moveMode=true;scheduleSave();notify('家具を追加しました。移動モードです')});if(selection&&tab==='furniture'){$('#move').onclick=()=>{moveMode=!moveMode;renderPanel()};$('#rotateL').onclick=()=>{snapshot();selection.rotation.y-=Math.PI/12;keepInside(selection);renderPanel();scheduleSave()};$('#rotateR').onclick=()=>{snapshot();selection.rotation.y+=Math.PI/12;keepInside(selection);renderPanel();scheduleSave()};$('#duplicate').onclick=()=>{snapshot();const item=addObject({...serialize().objects.find(o=>o.id===selection.userData.id),id:nextId++,x:Math.min(2.25,selection.position.x+.5),z:Math.min(3.25,selection.position.z+.5)});freeSpot(item);selectObject(item);scheduleSave()};$('#delete').onclick=()=>removeFurniture(selection)}if(tab==='interior'){for(const [key,prop] of [['wall','wallName'],['floor','floorName']]){$('#'+key).onchange=e=>{snapshot();if(prop==='wallName')wallName=e.target.value;else floorName=e.target.value;applyMaterials();scheduleSave()}}}if(tab==='window'){$('#timeMode').onchange=e=>{snapshot();timeMode=e.target.value;applyMaterials();renderPanel();scheduleSave();refreshClock()};if($('#customHour'))$('#customHour').oninput=e=>{customHour=Number(e.target.value);$('#hourText').textContent=String(customHour).padStart(2,'0')+':00';applyMaterials();scheduleSave();refreshClock()};$('#lookAtWindow').onclick=focusWindow;document.querySelectorAll('[data-window]').forEach(b=>b.onclick=()=>{snapshot();windowView=b.dataset.window;sceneCategory=['cityday','citynight','sunset'].includes(windowView)?'city':windowView;if(windowView==='citynight'||windowView==='sunset'){timeMode='manual';customHour=windowView==='citynight'?21:17;}applyMaterials();renderPanel();scheduleSave();notify('窓の景色を変更しました')})}if(tab==='lighting'){document.querySelectorAll('[data-time]').forEach(b=>b.onclick=()=>{snapshot();timeMode='manual';customHour=b.dataset.time==='night'?21:b.dataset.time==='sunset'?17:12;applyMaterials();renderPanel();scheduleSave()});$('#light').onpointerdown=()=>snapshot();$('#light').oninput=e=>{lightStrength=Number(e.target.value);$('#lightValue').textContent=lightStrength+'%';applyMaterials();scheduleSave()}}}
let pointerStart=null;const raycaster=new THREE.Raycaster(),mouse=new THREE.Vector2(),ground=new THREE.Plane(new THREE.Vector3(0,1,0),0);function getRay(e){const b=renderer.domElement.getBoundingClientRect();mouse.set((e.clientX-b.left)/b.width*2-1,-(e.clientY-b.top)/b.height*2+1);raycaster.setFromCamera(mouse,camera)}
function hitObject(e){getRay(e);const hit=raycaster.intersectObjects(objects,true)[0];if(!hit)return null;let o=hit.object;while(o.parent&&!o.userData.id)o=o.parent;return o.userData.id?o:null}
renderer.domElement.addEventListener('pointerdown',e=>{if(!editing||e.button!==0||!e.isPrimary)return;pointerStart={x:e.clientX,y:e.clientY};const hit=hitObject(e);if(hit){selectObject(hit);if(moveMode){e.preventDefault();snapshot();dragging=true;oldDrag={x:hit.position.x,z:hit.position.z};controls.enabled=false;renderer.domElement.setPointerCapture(e.pointerId)}}});
renderer.domElement.addEventListener('pointermove',e=>{if(!dragging||!selection)return;getRay(e);const out=new THREE.Vector3();if(raycaster.ray.intersectPlane(ground,out)){const previous=selection.position.clone();selection.position.x=out.x;selection.position.z=out.z;keepInside(selection);if(objects.some(o=>overlapsFurniture(o,selection)))selection.position.copy(previous)}});
function finishDrag(){if(dragging){dragging=false;controls.enabled=true;moveMode=false;renderPanel();scheduleSave()}}
renderer.domElement.addEventListener('pointerup',finishDrag);renderer.domElement.addEventListener('pointercancel',finishDrag);
function updateDrawer(){const ed=$('#editor');ed.classList.toggle('open',editing);ed.classList.toggle('expanded',panelExpanded);ed.classList.toggle('collapsed',panelCollapsed);$('#expandPanel').textContent=panelExpanded?'⊟':'⤢';$('#collapsePanel').textContent=panelCollapsed?'⌃':'⌄';$('#expandPanel').setAttribute('aria-label',panelExpanded?'編集パネルを縮小':'編集パネルを拡大');$('#collapsePanel').setAttribute('aria-label',panelCollapsed?'編集パネルを開く':'編集パネルを折りたたむ')}
function cameraHome(){controls.enabled=true;dragging=false;controls.reset();controls.target.set(0,.7,-.25);const mobile=innerWidth<700;camera.fov=mobile?58:48;camera.position.set(mobile?13:11,mobile?10:8.5,mobile?20:14);camera.updateProjectionMatrix();controls.update();notify('部屋全体に戻しました')}
function cameraTop(){controls.target.set(0,0,0);camera.position.set(0,23,.01);controls.update();notify('真上からの視点')}
function zoomBy(factor){const v=camera.position.clone().sub(controls.target);v.multiplyScalar(factor);v.clampLength(controls.minDistance,controls.maxDistance);camera.position.copy(controls.target).add(v);controls.update()}
function focusWindow(){
  dragging=false;controls.enabled=true;
  const mobile=innerWidth<700;
  // From inside the room, look toward the back-wall window.
  controls.target.set(0,1.35,-3.65);
  camera.position.set(mobile?1.8:1.1,mobile?2.55:2.35,mobile?5.5:4.15);
  camera.fov=mobile?62:50;camera.updateProjectionMatrix();controls.update();
  notify('窓の方向に移動しました');
}
function openWindowPanel(){
  editing=true;tab='window';moveMode=false;panelCollapsed=false;panelExpanded=false;
  updateDrawer();renderPanel();$('#toggleEdit').textContent='DONE';
  focusWindow();
}
$('#quickWindow').onclick=openWindowPanel;
$('#focusWindow').onclick=focusWindow;
$('#cameraHome').onclick=cameraHome;$('#resetView').onclick=cameraHome;$('#cameraTop').onclick=cameraTop;$('#cameraZoomIn').onclick=()=>zoomBy(.8);$('#cameraZoomOut').onclick=()=>zoomBy(1.3);
$('#expandPanel').onclick=()=>{panelExpanded=!panelExpanded;panelCollapsed=false;updateDrawer()};$('#collapsePanel').onclick=()=>{panelCollapsed=!panelCollapsed;panelExpanded=false;updateDrawer()};document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;panelCollapsed=false;updateDrawer();renderPanel()});$('#save').onclick=saveNow;$('#undo').onclick=()=>restore(undoStack,redoStack);$('#redo').onclick=()=>restore(redoStack,undoStack);
document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveNow()}else if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='z'){e.preventDefault();e.shiftKey?restore(redoStack,undoStack):restore(undoStack,redoStack)}else if((e.key==='Delete'||e.key==='Backspace')&&selection&&editing&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)){snapshot();scene.remove(selection);objects.splice(objects.indexOf(selection),1);selection=null;renderPanel();scheduleSave()}});

// LIFE MODE v0.5: lightweight first-person exploration on the same room data.
let currentMode='life',lifeYaw=0,lifePitch=0,lifeStanding=new THREE.Vector3(0,1.63,2.8),lifeSeated=false,lifeTarget=null,walkInput={forward:false,back:false,left:false,right:false};
const keys=new Set();const editView={position:new THREE.Vector3(),target:new THREE.Vector3()};
function refreshClock(){const h=timeMode==='real'?new Date().getHours():customHour;const minutes=timeMode==='real'?new Date().getMinutes():0;$('#lifeClock').textContent=String(h).padStart(2,'0')+':'+String(minutes).padStart(2,'0')+(timeMode==='real'?' · REAL':' · CUSTOM')}
function toMode(mode){
 if(mode===currentMode&&document.body.classList.contains(mode+'-mode'))return;
 if(currentMode==='edit'){editView.position.copy(camera.position);editView.target.copy(controls.target)}
 currentMode=mode;editing=mode==='edit';moveMode=false;dragging=false;controls.enabled=editing;
 document.body.classList.toggle('life-mode',!editing);document.body.classList.toggle('edit-mode',editing);
 $('#lifeMode').classList.toggle('active',!editing);$('#editMode').classList.toggle('active',editing);
 $('#lifeMode').setAttribute('aria-pressed',String(!editing));$('#editMode').setAttribute('aria-pressed',String(editing));
 $('#toggleEdit').textContent=editing?'DONE':'EDIT';
 panelCollapsed=innerWidth<700;panelExpanded=false;updateDrawer();renderPanel();
 if(editing){camera.fov=innerWidth<700?58:48;camera.position.copy(editView.position.length()>2?editView.position:new THREE.Vector3(11,8.5,14));controls.target.copy(editView.target.lengthSq()>0?editView.target:new THREE.Vector3(0,.7,-.25));camera.updateProjectionMatrix();controls.update();}
 else{lifeSeated=false;lifeTarget=null;$('#lifeAction').hidden=true;lifeStanding.set(0,1.63,2.8);lifeYaw=0;lifePitch=0;camera.fov=innerWidth<700?73:67;camera.updateProjectionMatrix();camera.position.copy(lifeStanding);camera.rotation.order='YXZ';camera.rotation.set(lifePitch,lifeYaw,0);}
 refreshClock();notify(editing?'部屋編集モード':'LIFE MODE：部屋を歩けます');
}
$('#lifeMode').onclick=()=>toMode('life');$('#editMode').onclick=()=>toMode('edit');
$('#toggleEdit').onclick=()=>toMode(editing?'life':'edit');
function occupantCollision(x,z){
 if(x<-2.67||x>2.67||z<-3.65||z>3.65)return true;
 return objects.some(o=>{if(['rug','art'].includes(o.userData.type))return false;const b=worldBox(o);const margin=.24;return x>b.min.x-margin&&x<b.max.x+margin&&z>b.min.z-margin&&z<b.max.z+margin});
}
let lifeTouch=null;
renderer.domElement.addEventListener('pointerdown',e=>{if(currentMode!=='life'||e.pointerType==='touch'&&!e.isPrimary)return;lifeTouch={id:e.pointerId,x:e.clientX,y:e.clientY,downX:e.clientX,downY:e.clientY};renderer.domElement.setPointerCapture(e.pointerId)});
renderer.domElement.addEventListener('pointermove',e=>{if(currentMode!=='life'||!lifeTouch||e.pointerId!==lifeTouch.id)return;const dx=e.clientX-lifeTouch.x,dy=e.clientY-lifeTouch.y;lifeTouch.x=e.clientX;lifeTouch.y=e.clientY;lifeYaw-=dx*.004;lifePitch=THREE.MathUtils.clamp(lifePitch-dy*.0035,-1.25,1.25)});
renderer.domElement.addEventListener('pointerup',e=>{if(currentMode!=='life'||!lifeTouch||e.pointerId!==lifeTouch.id)return;const delta=Math.hypot(e.clientX-lifeTouch.downX,e.clientY-lifeTouch.downY);lifeTouch=null;if(delta<12){const hit=hitObject(e);lifeTarget=hit;const action=$('#lifeAction');action.hidden=!hit;if(hit)action.textContent=['sofa','chair','bed'].includes(hit.userData.type)?'座る・休む':hit.userData.type==='lamp'?'ライト切替':'家具を見る';}});
$('#lifeAction').onclick=()=>{if(!lifeTarget)return;const type=lifeTarget.userData.type;if(['sofa','chair','bed'].includes(type)){lifeSeated=!lifeSeated;if(lifeSeated){const pos=lifeTarget.position;lifeStanding.set(THREE.MathUtils.clamp(pos.x,.0-2.65,2.65),type==='bed'?.9:1.12,THREE.MathUtils.clamp(pos.z+.42,-3.65,3.65));$('#lifeAction').textContent='立ち上がる'}else{lifeStanding.y=1.63;lifeStanding.z+=.8;$('#lifeAction').textContent='座る・休む'}}else if(type==='lamp'){lifeLightOn=!lifeLightOn;applyMaterials();notify(lifeLightOn?'照明をつけました':'照明を消しました')}else{notify('EDIT MODEで家具を調整できます')}};
for(const b of document.querySelectorAll('[data-walk]')){const direction=b.dataset.walk;const on=e=>{e.preventDefault();walkInput[direction]=true;b.setPointerCapture(e.pointerId)};const off=e=>{walkInput[direction]=false};b.addEventListener('pointerdown',on);b.addEventListener('pointerup',off);b.addEventListener('pointercancel',off);b.addEventListener('lostpointercapture',off)}
addEventListener('keydown',e=>{if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;keys.add(e.key.toLowerCase());if(currentMode==='life'&&['arrowup','arrowdown','arrowleft','arrowright',' '].includes(e.key.toLowerCase()))e.preventDefault();if(e.key==='Escape'&&currentMode==='life'&&lifeSeated){lifeSeated=false;lifeStanding.y=1.63}});
addEventListener('keyup',e=>keys.delete(e.key.toLowerCase()));
function updateLife(dt){if(currentMode!=='life')return;const forward=Number(walkInput.forward||keys.has('w')||keys.has('arrowup'))-Number(walkInput.back||keys.has('s')||keys.has('arrowdown'));const side=Number(walkInput.right||keys.has('d')||keys.has('arrowright'))-Number(walkInput.left||keys.has('a')||keys.has('arrowleft'));
 if(!lifeSeated&&(forward||side)){const speed=Math.min(dt,.04)*2.0/Math.max(1,Math.hypot(forward,side));const dx=(-Math.sin(lifeYaw)*forward+Math.cos(lifeYaw)*side)*speed,dz=(-Math.cos(lifeYaw)*forward-Math.sin(lifeYaw)*side)*speed;if(!occupantCollision(lifeStanding.x+dx,lifeStanding.z))lifeStanding.x+=dx;if(!occupantCollision(lifeStanding.x,lifeStanding.z+dz))lifeStanding.z+=dz}
 camera.position.copy(lifeStanding);camera.rotation.order='YXZ';camera.rotation.set(lifePitch,lifeYaw,0);
}
setInterval(()=>{refreshClock();if(timeMode==='real')applyMaterials()},45000);
function fit(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)}addEventListener('resize',fit);cameraHome();
try{let saved=localStorage.getItem('roomverse-prototype-v3')||localStorage.getItem('roomverse-prototype-v2')||localStorage.getItem('roomverse-prototype-v1');
 if(saved&&!localStorage.getItem('roomverse-pre032-original'))localStorage.setItem('roomverse-pre032-original',saved);
 apply(saved?JSON.parse(saved):{objects:defaults});
 if(!saved)saveNow();else if(JSON.stringify(serialize())!==saved)scheduleSave();
}catch(e){apply({objects:defaults});notify('保存データの読み込みに失敗しました。元データは削除していません')}refreshUndo();const clock=new THREE.Clock();editView.position.set(11,8.5,14);editView.target.set(0,.7,-.25);toMode('life');function animate(){requestAnimationFrame(animate);const dt=clock.getDelta();if(currentMode==='edit')controls.update();else updateLife(dt);renderer.render(scene,camera)}animate();
</script>
</body></html>
